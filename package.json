{
  "name": "tarab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "doctor": "node scripts/dev-doctor.mjs",
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "dev:app": "tauri dev",
    "build": "tsc && vite build && node scripts/check-initial-bundle.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "tsc --noEmit && biome check . && vitest run && vite build && node scripts/check-initial-bundle.mjs",
    "analyze": "tsc && vite build --mode analyze && node scripts/check-initial-bundle.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "knip": "knip",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "verify:release": "tsc --noEmit && biome check . && vitest run && vite build && node scripts/check-initial-bundle.mjs && storybook build && knip && cargo test --manifest-path src-tauri/Cargo.toml && cargo check --manifest-path src-tauri/Cargo.toml",
    "build:app": "pnpm tauri build",
    "open:app": "open src-tauri/target/release/bundle/macos/Tarab.app",
    "clean": "node scripts/clean.mjs",
    "clean:deep": "node scripts/clean.mjs && cargo clean --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/geist-mono": "^5.2.7",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sentry/react": "^10.44.0",
    "@tanstack/query-async-storage-persister": "^5.90.27",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.24",
    "@tanstack/react-virtual": "^3.13.23",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.7",
    "@tauri-apps/plugin-dialog": "2.4.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "@tauri-apps/plugin-positioner": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "blurhash": "^2.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "comlink": "^4.4.2",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.1.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.562.0",
    "p-limit": "^7.3.0",
    "react": "^19.1.0",
    "react-aria-components": "^1.16.0",
    "react-blurhash": "^0.3.0",
    "react-confetti-explosion": "^3.0.3",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.71.2",
    "react-hotkeys-hook": "^5.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "three": "^0.170.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^25.0.1",
    "knip": "^5.88.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.0"
  }
}
