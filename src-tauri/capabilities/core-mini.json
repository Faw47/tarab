{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "core-mini",
  "description": "Mini-player core permissions are limited to snapshot/control events plus its own drag and minimize controls.",
  "windows": ["mini-player"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize"
  ]
}
