{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "core-main",
  "description": "Main-window core permissions for event listen/unlisten/emit-to routing, startup show, Windows window controls, and liquid-glass support checks/effect application.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to",
    "core:window:allow-show",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "liquid-glass:allow-is-glass-supported",
    "liquid-glass:allow-set-liquid-glass-effect"
  ]
}
