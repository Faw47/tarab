{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tarab",
  "version": "0.1.0",
  "identifier": "com.fawaz.tarab",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "TARAB",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 14
        },
        "transparent": true,
        "visible": true
      },
      {
        "label": "mini-player",
        "title": "Tarab Mini",
        "url": "mini-player.html",
        "width": 320,
        "height": 92,
        "minWidth": 320,
        "minHeight": 92,
        "maxWidth": 320,
        "maxHeight": 92,
        "resizable": false,
        "decorations": false,
        "minimizable": true,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: cover-art:; media-src 'self' data: blob: asset:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "deepLink": {
      "mobile": [],
      "desktop": ["tarab://open"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["mp3"], "name": "MP3 Audio", "description": "MP3 Audio File", "role": "Viewer" },
      { "ext": ["flac"], "name": "FLAC Audio", "description": "FLAC Audio File", "role": "Viewer" },
      { "ext": ["aiff"], "name": "AIFF Audio", "description": "AIFF Audio File", "role": "Viewer" },
      { "ext": ["wav"], "name": "WAV Audio", "description": "WAV Audio File", "role": "Viewer" },
      { "ext": ["ogg"], "name": "OGG Audio", "description": "OGG Audio File", "role": "Viewer" },
      { "ext": ["m4a"], "name": "M4A Audio", "description": "M4A Audio File", "role": "Viewer" },
      { "ext": ["aac"], "name": "AAC Audio", "description": "AAC Audio File", "role": "Viewer" }
    ]
  }
}
